{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/*/index.js",
		"src/shared/**/*.js",
		"!src/shared/**/__tests__/**",
		"src/build-kit/**/*.{js,cjs,mjs}",
		"scripts/*.{js,mjs}"
	],
	"project": [
		"src/**/*.js",
		"!src/**/__tests__/**",
		"!src/**/__mocks__/**",
		"!src/**/test-utils/**"
	],
	"paths": {
		"@newspack-nodes/runtime": [
			"src/runtime/index.js"
		],
		"@newspack-nodes/shared/*": [
			"src/shared/*"
		],
		"@newspack-nodes/shared": [
			"src/shared/index.js"
		],
		"@newspack-nodes/debug-overlay": [
			"src/debug-overlay/DebugOverlay.js"
		],
		"@newspack-nodes/build-kit": [
			"src/build-kit/index.mjs"
		]
	},
	"ignoreBinaries": [
		"php",
		"phpcs",
		"phpcbf",
		"shellcheck",
		"wp"
	],
	"ignoreDependencies": [
		"@commitlint/cli",
		"lint-staged",
		"postcss-scss",
		"babel-jest",
		"jest-environment-jsdom",
		"@testing-library/react",
		"react-dom",
		"jsdom",
		"@csstools/selector-specificity",
		"postcss-selector-parser",
		"@babel/parser"
	],
	"jest": false,
	"tags": [
		"-@testonly"
	],
	"rules": {
		"duplicates": "off"
	}
}
