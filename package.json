{
	"name": "newspack-nodes",
	"version": "0.7.0",
	"private": true,
	"description": "Node-graph runtime for composable PHP services.",
	"author": "Automattic",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "npm run clean && npm run sync && node scripts/build.mjs",
		"clean": "rm -rf build",
		"sync": "./sync-shared.sh",
		"release:archive": "./build-release.sh",
		"fix:js": "eslint --fix 'src/**/*.{js,jsx}'",
		"fix:php": "phpcbf",
		"fix:scss": "stylelint --customSyntax postcss-scss --fix 'src/**/*.scss'",
		"format": "prettier --write 'src/**/*.{js,jsx,scss,json}'",
		"format:js": "prettier --write 'src/**/*.{js,jsx}'",
		"lint:js": "eslint 'src/**/*.{js,jsx}'",
		"lint:php": "phpcs",
		"lint:phpstan": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
		"lint:scss": "stylelint --customSyntax postcss-scss 'src/**/*.scss'",
		"make-pot": "wp i18n make-pot . languages/newspack-nodes.pot --domain=newspack-nodes --exclude=node_modules,build,vendor,tests,release",
		"test:js": "jest --passWithNoTests",
		"test:js:coverage": "jest --passWithNoTests --coverage --collectCoverageFrom='src/**/*.{js,jsx}' --coverageReporters=json-summary --coverageReporters=text"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/i18n": "^6.18.0"
	},
	"devDependencies": {
		"@babel/preset-env": "^7.29.5",
		"@babel/preset-react": "^7.28.5",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^19.8.1",
		"@testing-library/react": "^16.3.2",
		"@wordpress/eslint-plugin": "^24.5.0",
		"@wordpress/prettier-config": "^4.46.0",
		"@wordpress/stylelint-config": "^23.38.0",
		"babel-jest": "^30.4.1",
		"esbuild": "^0.28.0",
		"eslint": "^8.57.1",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"lint-staged": "^15.5.2",
		"postcss-scss": "^4.0.9",
		"prettier": "npm:wp-prettier@^3.0.3",
		"rtlcss": "^4.3.0",
		"sass": "^1.99.0",
		"stylelint": "^16.26.1"
	},
	"lint-staged": {
		"*.{js,jsx}": "eslint",
		"*.scss": "stylelint --customSyntax postcss-scss",
		"*.php": [
			"phpcs",
			"sh -c 'npm run lint:phpstan --silent'"
		]
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"overrides": {
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^9.0.7"
		}
	}
}
