# AI Newsletter — scored, durable digest pipeline (dashboard chapter).
#
#   community ┐
#             ├─ summarizer ─ scorer ─ scored:partition      (durable `scored` log)
#   releases ─┘
#   scored:consumer ─ digest ─ digest:tee ─ digest:log
#
# summarizer adds a one-line summary; scorer adds a notional priority score and
# appends each scored item to the durable `scored` partition. A Consumer
# tails that log into the digest, and co-commits the digest's accumulated state
# (save_state) into its offsetlog via `add_snapshot_node digest` — so a respawned
# worker restores in lockstep with the cursor. Insights_CI_Demo reads that offsetlog
# snapshot to serve the dashboard. `void_warranty` lifts the partition's 4KB
# write cap (a scored batch can exceed PIPE_BUF); see ADR-4.
var num_partitions = 1

make_node Releases_Source_Demo  releases
make_node Community_Source_Demo community
make_node Summarizer_Demo       summarizer
make_node Digest_Builder_Demo   digest
make_node Tee                   digest:tee
make_node Log                   digest:log /tmp/example-ai-newsletter/digest.md 1 2 7 0 0
cmd digest:log:config void_warranty
# `example-scored` log paths (not bare `scored`) keep this demo's data isolated from a
# real plugin's `scored` log in the same substrate dir; MUST match Insights_CI_Demo's glob.
make_node Partition             scored:partition <config:logs_dir>/example-scored.p<partition> <config:segment_size> <config:min_segments> <config:max_segments> <config:min_lifetime> <config:max_lifetime>
cmd scored:partition:config void_warranty
make_node Consumer              scored:consumer <config:logs_dir>/example-scored.p<partition> <config:offsets_dir>/example-scored.p<partition> <config:deadletter_dir>/example-scored.p<partition>
cmd scored:consumer:config add_snapshot_node digest
make_node Scorer_Demo           scorer
connect_node releases        summarizer
connect_node community       summarizer
connect_node summarizer      scorer
connect_node scorer          scored:partition
connect_node scored:consumer digest
connect_node digest          digest:tee
connect_node digest:tee      digest:log
