# PHPStan gate with dead-code detection enabled.
#
# shipmonk/dead-code-detector is excluded from the auto-loaded extension set
# (see composer.json extra.phpstan/extension-installer.ignore), so use this
# explicit config whenever running the project PHPStan gate:
#
#     npm run lint:phpstan
#
# Caveat: this is a SUBSTRATE. tests/ are excluded (inherited from the main
# config) so test-only methods surface, and cross-plugin consumers (ELN /
# pyrobase / ai-newsletter) live in separate repos the analysis can't see — so
# most findings are public API, WP/CLI entrypoints, JS↔PHP wire constants, or
# deliberate test seams, NOT genuinely dead. Verify each finding against ALL
# call paths (dynamic dispatch, hooks, reflection, the sibling repos, and JS)
# before deleting. `@api` tags can be added later to quiet the known-public
# surface.
includes:
    - phpstan.neon.dist
    - vendor/shipmonk/dead-code-detector/rules.neon
parameters:
    # Keep ShipMonk's collected-data cache project-local. The default global
    # PHPStan tmp dir can race when multiple plugin gates run concurrently.
    tmpDir: .phpstan/cache/deadcode
