# Job-workers topology.
#
#   Consumer (jobs.log) ─→ JobWorker

# Frontmatter — the runtime reads these via Topology_Registry::frontmatter().
# Handlers that block on serial HTTP pump() the continue-predicate at their
# fetch point, so the heartbeat rides along and the default window holds.
var stale_timeout = 60;

include topic-probe

# A throwing job handler propagates back to the Consumer, which quarantines the
# job to its :deadletter sibling (dead-letter [42]) instead of silently dropping it.
make_node Consumer jobs:consumer <config:logs_dir>/jobs.p<partition> <config:offsets_dir>/<topology>.jobs.p<partition> <config:deadletter_dir>/<topology>.jobs.p<partition>
cmd jobs:consumer:config set_line_mode true
make_node Job_Worker job-worker
connect_node jobs:consumer job-worker

# Jobstats sweep: a 15s Job_Probe snapshots this process's Job_Workers into
# the shared jobstats.p0 log (1 MiB x 8 segments, keep a day). The fixed .p0
# dir is one multi-writer log every job-worker partition appends to.
make_node Partition jobstats:log <config:logs_dir>/jobstats.p0 1048576 2 8 0 86400 86400
make_node Job_Probe jobstats 15
connect_node jobstats jobstats:log
secure
