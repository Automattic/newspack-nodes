# Job_Intake topology — drain the large-write job ingress into jobs.log on
# SUBSTRATE-ONLY installs (no event-logger). ELN's job-router.tsl `include`s
# this file and re-routes the leg through Job_Router — the conflict gate (shared
# jobs:partition under void_warranty) refuses co-activating the two.
#
#   Tail (jobintake.log) ──→ Partition (jobs:partition)

include topic-probe

make_node Consumer jobintake:consumer <config:logs_dir>/jobintake.p<partition> <config:offsets_dir>/<topology>.jobintake.p<partition> <config:deadletter_dir>/<topology>.jobintake.p<partition>
make_node Partition jobs:partition <config:logs_dir>/jobs.p<partition>
cmd jobs:partition:config void_warranty
connect_node jobintake:consumer jobs:partition
secure
