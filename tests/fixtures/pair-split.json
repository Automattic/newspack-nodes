[
  ["a partition source and a plain target", "firehose.p0=remote-job-rewrite", "firehose.p0", "remote-job-rewrite"],
  ["a source keeps its colons", "sources:php=php-errors:partition", "sources:php", "php-errors:partition"],
  ["a colon-named target node stays whole", "firehose.p0=spokes:tw0:firehose.p0", "firehose.p0", "spokes:tw0:firehose.p0"],
  ["a reader stamp is one source", "offsets:hub.tw0:firehose.p0=cursor-sink", "offsets:hub.tw0:firehose.p0", "cursor-sink"],
  ["a target keeps every equals sign after the first", "kea.p2=okapi=sink", "kea.p2", "okapi=sink"],
  ["a partition token stays whole", "firehose.p{partition}=remote-job-rewrite", "firehose.p{partition}", "remote-job-rewrite"],
  ["a config token stays whole", "<config:kea_log>.p3=kea-sink", "<config:kea_log>.p3", "kea-sink"],
  ["a token with no equals sign is all source", "jobstats.p7", "jobstats.p7", ""],
  ["an empty source", "=marmot-sink", "", "marmot-sink"],
  ["an empty target", "marmot.p5=", "marmot.p5", ""],
  ["an empty token", "", "", ""]
]
