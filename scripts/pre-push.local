# shellcheck shell=bash
# newspack-nodes' constants and gates, sourced by the shared scripts/pre-push.

# The shared tooling's self-tests, run here on the one copy the sync vendors:
# each script, then what it tests, as the step and its verdict name it.
SELF_TESTS=(
	"test-reorder-node-methods.sh" "the reorder twins"
	"test-lint-comments.sh" "the comment gate"
	"test-fix-blank-lines.sh" "the blank-line fixer"
	"test-lint-contract.sh" "the contract gate"
	"test-lint-styles.sh" "the style gate"
	"test-lint-wp-pin.sh" "the pin gate"
	"test-render-diagram.sh" "the diagram renderer"
	"test-coverage-gate.sh" "the per-class coverage gate"
	"test-coverage-gate-js.sh" "the per-file JS coverage gate"
	"test-pre-push.sh" "the pre-push hook"
)

push_gates() {
	local i
	for (( i = 0; i < ${#SELF_TESTS[@]}; i += 2 )); do
		script_gate "${SELF_TESTS[i]}" \
			"${SELF_TESTS[i]} (${SELF_TESTS[i + 1]}'s own tests)" \
			"${SELF_TESTS[i]} failed — ${SELF_TESTS[i + 1]} is broken (see above)" \
			"${SELF_TESTS[i + 1]} clean"
	done
}

container_gates() { :; }

# PHPUnit runs straight from the /services mount, never /usr/src.
# shellcheck disable=SC2034 # scripts/pre-push reads every constant
{
	readonly PLUGIN_SLUG="newspack-nodes"
	readonly CONTAINER="${HOST}-pyrobase1-1"
	readonly DEPLOY_CONTAINER="$CONTAINER"
	readonly DEPLOY_SCRIPT="/services/pyrobase/setup/${PLUGIN_SLUG}.sh"
	readonly TEST_DIR_IN_CONTAINER="/services/pyrobase/sources/${PLUGIN_SLUG}/tests"
	readonly COVERAGE_DIR="${PLUGIN_SLUG}-coverage"
}
