#!/usr/bin/env bash
# Pre-push gate, shared by every plugin.
#
# newspack-nodes holds the authoritative copy, and sync-shared-scripts.sh
# vendors it into each sibling on pre-commit. What differs per plugin lives in
# scripts/pre-push.local, which this hook sources and the sync never touches:
# six constants naming the plugin and its container, and two slot functions
# holding the plugin's own gates.
#
#   push_gates       every push, after the shared gates
#   container_gates  PHP pushes, in the container after the coverage suite
#
# A gate that runs scripts/<file> when the plugin carries it is one
# script_gate line; anything else is plain shell in its slot.
#
# JS tests (npm run test:js:coverage) run on EVERY push — they're fast, and they
# can break from a sibling-repo shared-runtime change this push never touched
# (the @newspack-nodes/* alias resolves to the nodes source), which a
# file-type-scoped gate misses on a PHP-only or docs-only push.
#
# Everything else is smart-scoped by file type touched in the push range:
#
#   PHP changed  → npm run lint:php + deploy + coverage suite + container_gates
#                  + per-class 90% gate; with the container up, a push from a
#                  git worktree is refused before any gate, because the
#                  container mounts the main checkout and would test that
#   JS changed   → npm run lint:js   + npm run build
#   TS changed   → npm run lint:types, where package.json declares it
#   SCSS changed → npm run lint:scss + npm run build
#
# Skips the SCOPED gates when the push is only docs / CHANGELOG / config-only
# tweaks (the JS tests still run). Skip the whole gate with `git push
# --no-verify` when you know it's fine (in-flight WIP branches, etc.).
#
# Wired by `git config core.hooksPath scripts`, which `composer install` sets;
# a clone that has never run it has no hooks at all.

set -euo pipefail

HOST=$(hostname -s)
readonly HOST

red()    { printf '\033[31m%s\033[0m' "$*"; }
green()  { printf '\033[32m%s\033[0m' "$*"; }
yellow() { printf '\033[33m%s\033[0m' "$*"; }
dim()    { printf '\033[2m%s\033[0m' "$*"; }

step() { printf '%s %s\n' "$(yellow '→')" "$*" >&2; }
ok()   { printf '%s %s\n' "$(green '✓')" "$*" >&2; }
fail() { printf '%s %s\n' "$(red   '✗')" "$*" >&2; exit 1; }

# Uppercase names are the interface between this hook and pre-push.local.
TOPLEVEL="$(git rev-parse --show-toplevel)"
readonly TOPLEVEL
# dndocker sits four levels above the main checkout, which a worktree is not.
DNDOCKER="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/../../../.."
readonly DNDOCKER

# Runs scripts/$1 when present; no $4 where the script prints its own verdict.
script_gate() {
	local path="${TOPLEVEL}/scripts/$1"
	[[ -f "$path" ]] || return 0
	step "$2"
	bash "$path" || fail "$3"
	[[ -z "${4:-}" ]] || ok "$4"
}

# Holds this repo's date_math() port, side $1, to its twin at every pushed ref.
date_math_parity() {
	local tool="${DNDOCKER}/tools/check-date-math-parity.py" sha
	if [[ ! -f "$tool" ]]; then
		step "$(dim "date_math parity skipped — no $tool")"
		return 0
	fi
	command -v python3 >/dev/null || fail "no python3 on PATH — the date_math parity check cannot run"
	step "date_math parity (pyrobase vs nuclear-gyrobase)"
	for sha in "${pushed_shas[@]}"; do
		python3 "$tool" "--$1-repo" "$TOPLEVEL" "--$1-ref" "$sha" >&2 || fail "date_math parity failed — the two ports would shift a datetime differently (see above)"
	done
	ok "date_math parity clean"
}

local_conf="$(dirname "${BASH_SOURCE[0]}")/pre-push.local"
[[ -f "$local_conf" ]] || fail "no ${local_conf} — it declares this plugin's constants and gates"
# shellcheck source-path=SCRIPTDIR source=pre-push.local
. "$local_conf"
for constant in PLUGIN_SLUG CONTAINER DEPLOY_CONTAINER DEPLOY_SCRIPT \
	TEST_DIR_IN_CONTAINER COVERAGE_DIR; do
	[[ -n "${!constant:-}" ]] || fail "${local_conf} sets no ${constant}"
done
for slot in push_gates container_gates; do
	declare -F "$slot" >/dev/null || fail "${local_conf} defines no ${slot}()"
done

# One stdin line per pushed ref; a base this clone lacks diffs from empty.
empty_tree="$(git hash-object -t tree /dev/null)"
changed=""
refs=0
pushed_shas=()
# shellcheck disable=SC2034 # git's stdin protocol: remote_ref unused.
while read -r local_ref local_sha remote_ref remote_sha; do
	[[ -z "${local_sha:-}" ]] && continue
	if [[ "$local_sha" =~ ^0+$ ]]; then
		continue  # branch delete — nothing to gate
	fi
	if [[ "$remote_sha" =~ ^0+$ ]]; then
		base="$(git merge-base "$local_sha" origin/main 2>/dev/null \
		     || git merge-base "$local_sha" origin/trunk 2>/dev/null \
		     || git merge-base "$local_sha" origin/HEAD 2>/dev/null \
		     || echo "$empty_tree")"
	elif git rev-parse -q --verify "${remote_sha}^{commit}" >/dev/null; then
		base="$remote_sha"
	else
		base="$empty_tree"  # a force-push over work this clone never fetched
	fi
	step "checking $(dim "${local_ref} ${base}..${local_sha}")"
	ref_changed="$(git diff --name-only "$base" "$local_sha")" \
		|| fail "git diff ${base} ${local_sha} failed — cannot scope the push"
	changed+="${ref_changed}"$'\n'
	pushed_shas+=( "$local_sha" )
	refs=$((refs + 1))
done

if [[ "$refs" -eq 0 ]]; then
	step "$(dim 'nothing on stdin — skipping')"
	exit 0
fi
changed="$(printf '%s' "$changed" | sort -u)"

# Classify the diff by file type. Exclude generated / vendored paths.
php_changed="$(echo  "$changed" | grep -E '\.php$'           | grep -v -E '^(vendor/|release/)'          || true)"
js_changed="$(echo   "$changed" | grep -E '\.(js|jsx|mjs|cjs|ts|tsx)$' | grep -v -E '^(node_modules/|build/|release/)' || true)"
ts_changed="$(echo   "$changed" | grep -E '\.(ts|tsx)$'       | grep -v -E '^(node_modules/|build/|release/)' || true)"
scss_changed="$(echo "$changed" | grep -E '\.scss$'          | grep -v -E '^(node_modules/|build/|release/)' || true)"

# Read the listing whole: an early grep -q exit SIGPIPEs docker under pipefail.
container_up() {
	local names
	command -v docker >/dev/null 2>&1 || return 1
	names="$(docker ps --format '{{.Names}}' 2>/dev/null)" || return 1
	grep -qxF "$CONTAINER" <<<"$names"
}

# The container mounts the main checkout, never a worktree: refuse up front.
if [[ -n "$php_changed" ]] && container_up \
	&& [[ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]]; then
	fail "PHP push from the worktree ${TOPLEVEL}: ${CONTAINER} mounts the main checkout, so its deploy and coverage gates would test code this push does not contain — push from the main checkout"
fi

step "test:js (with coverage)"
npm run test:js:coverage --silent || fail "test:js failed — fix or push --no-verify"
ok "test:js clean"

# coverage-gate-js.mjs skips cleanly for a plugin with no JS.
jsgate="${TOPLEVEL}/scripts/coverage-gate-js.mjs"
jssummary="${TOPLEVEL}/coverage/coverage-summary.json"
if [[ -f "$jsgate" ]] && command -v node >/dev/null 2>&1; then
	step "JS coverage gate (every src file ≥ 90%)"
	node "$jsgate" "$jssummary" --threshold 90 >&2 \
		|| fail "JS coverage gate failed — a src file is below 90% (see above)"
	ok "JS coverage gate passed"
fi

# Every push, docs-only included, so the prose cannot drift from the runtime.
script_gate lint-docs.sh \
	"lint-docs (doc-vs-runtime drift)" \
	"lint-docs failed — docs drifted from the runtime (see above)" \
	"lint-docs clean"

# A @wordpress/* range or a drifted lock builds against the wrong WordPress.
wppin="${TOPLEVEL}/scripts/lint-wp-pin.mjs"
if [[ -f "$wppin" ]] && grep -q '"@wordpress/' "${TOPLEVEL}/package.json"; then
	step "lint-wp-pin (@wordpress/* declared exactly and locked to it)"
	node "$wppin" || fail "lint-wp-pin failed — a @wordpress/* dependency carries a range or the lock drifted (see above)"
	ok "wp pin clean"
fi

# The script prints its own verdict, and passes a plugin declaring no floor.
script_gate check-substrate-floor.sh \
	"substrate floor" \
	"substrate floor too low (see above)"

push_gates

if [[ -z "$php_changed" && -z "$js_changed" && -z "$scss_changed" ]]; then
	step "$(dim 'no PHP/JS/SCSS in range — skipping')"
	exit 0
fi

# --- Lint pass — only run the linters for file types that actually changed. -
if [[ -n "$php_changed" ]]; then
	step "lint:php ($(echo "$php_changed" | wc -l | tr -d ' ') file(s) changed)"
	npm run lint:php --silent || fail "lint:php failed — fix or push --no-verify"
	ok "lint:php clean"
	# phpstan runs in pre-commit, where the feedback loop is tightest.
fi
if [[ -n "$js_changed" ]]; then
	step "lint:js ($(echo "$js_changed" | wc -l | tr -d ' ') file(s) changed)"
	npm run lint:js --silent || fail "lint:js failed — fix or push --no-verify"
	ok "lint:js clean"
fi
if [[ -n "$ts_changed" ]]; then
	if grep -q '"lint:types"' "${TOPLEVEL}/package.json"; then
		step "lint:types ($(echo "$ts_changed" | wc -l | tr -d ' ') file(s) changed)"
		npm run lint:types --silent || fail "lint:types failed — fix or push --no-verify"
		ok "lint:types clean"
	else
		step "$(dim 'lint:types skipped — this plugin declares no lint:types script')"
	fi
fi
if [[ -n "$scss_changed" ]]; then
	step "lint:scss ($(echo "$scss_changed" | wc -l | tr -d ' ') file(s) changed)"
	npm run lint:scss --silent || fail "lint:scss failed — fix or push --no-verify"
	ok "lint:scss clean"
fi

# --- Build only when frontend changed (release-zip needs current build/). ---
if [[ -n "$js_changed" || -n "$scss_changed" ]]; then
	step "npm run build (frontend changed)"
	build_out="/tmp/${PLUGIN_SLUG}-pre-push-build.out"
	if ! npm run build >"$build_out" 2>&1; then
		tail -20 "$build_out" >&2
		fail "npm run build failed — full output at ${build_out}"
	fi
	ok "build clean"
fi

# --- PHP: deploy and the coverage suite, when the container is running. ----
if [[ -n "$php_changed" ]]; then
	if ! container_up; then
		step "$(dim "container ${CONTAINER} not available — skipping deploy + coverage")"
	else
		step "deploy → ${DEPLOY_CONTAINER}"
		docker exec "$DEPLOY_CONTAINER" "$DEPLOY_SCRIPT" >/dev/null || fail "deploy script failed"

		step "coverage suite in container (phpunit + clover)"
		out="/tmp/${PLUGIN_SLUG}-pre-push-coverage.out"
		# TEST_TMP lands the clover in the dndocker volume the host gate reads.
		if docker exec -u bend -e TEST_TMP=/volumes/pyrobase/tmp "$CONTAINER" \
			"${TEST_DIR_IN_CONTAINER}/run-coverage.sh" >"$out" 2>&1; then
			cov_rc=0
		else
			cov_rc=$?
		fi
		tail -3 "$out" >&2
		[[ "$cov_rc" -ne 0 ]] && fail "coverage suite failed (exit ${cov_rc}) — full output at ${out}"
		ok "coverage suite clean"

		container_gates

		# Per-class 90% gate; skips off-dndocker or without python3.
		gate="${TOPLEVEL}/scripts/coverage-gate.py"
		clover="${DNDOCKER}/volumes/pyrobase/tmp/${COVERAGE_DIR}/clover.xml"
		if [[ -f "$gate" && -f "$clover" ]] && command -v python3 >/dev/null 2>&1; then
			step "coverage gate (every class ≥ 90%)"
			python3 "$gate" "$clover" --threshold 90 >&2 \
				|| fail "coverage gate failed — a class is below 90% (see above)"
			ok "coverage gate passed"
		else
			step "$(dim 'coverage gate skipped (no clover / python3)')"
		fi
	fi
fi

ok "pre-push checks passed"
