#!/bin/sh
#
# pre-commit — refresh the shared tooling, then run the staged-file gates.
#
# Wired by `git config core.hooksPath scripts`, so the hook itself is version
# controlled rather than living only in each clone's .git/hooks. `composer
# install` sets that config; a clone that has never run it has no hooks at all.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd || exit 1)"

"$SCRIPT_DIR/sync-shared-scripts.sh"

# Private values stay out of a public repo where its pre-push.local says so.
# shellcheck source-path=SCRIPTDIR source=lib/private-data-gate.sh
. "$SCRIPT_DIR/lib/private-data-gate.sh"
private_gate="$(private_data_gate "$SCRIPT_DIR/pre-push.local")"
[ "$private_gate" = 0 ] || python3 -I "$SCRIPT_DIR/lint-private-data.py" --staged

# A bare tool resolves via PATH to a global composer.lock never chose.
node -e '
const scripts = require( process.cwd() + "/package.json" ).scripts || {};
const bare = Object.entries( scripts ).filter( ( [ , cmd ] ) =>
	/(^|[\s;&|(])(phpcs|phpcbf|phpstan|phpunit)(\s|$)/.test( cmd )
);
for ( const [ name, cmd ] of bare ) {
	console.error( `package.json "${ name }" runs a bare PHP tool: ${ cmd }` );
}
if ( bare.length ) {
	console.error( "Spell it ./vendor/bin/<tool>." );
	process.exit( 1 );
}
'

[ -x ./node_modules/.bin/lint-staged ] || exit 0

exec ./node_modules/.bin/lint-staged
